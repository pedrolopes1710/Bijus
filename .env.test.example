# Ambiente de teste/local sem domínio público.
# Usa o IP local do computador/servidor onde vais correr Docker.
#
# Exemplo:
# PUBLIC_SITE_URL=http://192.168.1.50

DOMAIN=:80
PUBLIC_SITE_URL=http://IP_LOCAL_DO_SERVIDOR
ACME_EMAIL=teste@example.com

# Database
MSSQL_DATABASE=Bijus
MSSQL_SA_PASSWORD=ChangeThis_StrongPassword_123!

# Generate with:
# openssl rand -hex 64
JWT_SECRET=ChangeThisToAReallyLongRandomSecretWithAtLeast64Characters

# Backoffice (usernames separados por vírgula):
#   SUPER_ADMIN_USERS -> gere tudo;  ADMIN_USERS -> logística (encomendas + stock)
SUPER_ADMIN_USERS=
ADMIN_USERS=

# Optional social login through Auth0
# Para teste local, deixa vazio por agora.
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_AUTH0_REDIRECT_URI=http://IP_LOCAL_DO_SERVIDOR/auth/callback
NEXT_PUBLIC_AUTH0_GOOGLE_CONNECTION=google-oauth2
NEXT_PUBLIC_AUTH0_FACEBOOK_CONNECTION=facebook
