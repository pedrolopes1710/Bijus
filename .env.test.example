# =============================================================================
# Biscuit&Arte — variáveis de ambiente (TESTE / LOCAL, sem domínio público)
#
#   cp .env.test.example .env
#
# Arranque:
#   docker compose up -d --build
#
# O Caddy é publicado no host em 8090 (HTTP) e 8453 (HTTPS) — ver
# docker-compose.yml. Por isso o URL local leva sempre ":8090".
#
# Para produção usa .env.example + DEPLOY.md, não este ficheiro.
# =============================================================================

# -----------------------------------------------------------------------------
# Endereço
# -----------------------------------------------------------------------------
# Caddy escuta em :80 dentro do container, sem HTTPS (não há domínio).
DOMAIN=:80

# Substitui pelo IP da máquina onde corre o Docker (ou localhost se for a tua).
# Tem de incluir :8090, senão os links dos emails, o CORS e o ReturnUrl da
# Stripe apontam para uma porta onde não está nada.
PUBLIC_SITE_URL=http://localhost:8090
# Exemplo noutra máquina da rede:  PUBLIC_SITE_URL=http://192.168.1.50:8090

ACME_EMAIL=teste@example.com

# -----------------------------------------------------------------------------
# Base de dados
# -----------------------------------------------------------------------------
MSSQL_DATABASE=Bijus
MSSQL_SA_PASSWORD=ChangeThis_StrongPassword_123!

# -----------------------------------------------------------------------------
# Autenticação
# -----------------------------------------------------------------------------
# openssl rand -hex 64   (em teste qualquer string longa serve)
JWT_SECRET=ChangeThisToAReallyLongRandomSecretWithAtLeast64Characters

# Backoffice — usernames separados por vírgula:
#   SUPER_ADMIN_USERS -> acesso total;  ADMIN_USERS -> encomendas + stock
# Põe aqui o username com que te registas, senão não entras no /admin.
SUPER_ADMIN_USERS=
ADMIN_USERS=

# -----------------------------------------------------------------------------
# Google Sign-In (opcional em teste)
# -----------------------------------------------------------------------------
# Mesmo Client ID de produção, mas adiciona http://localhost:8090 às
# "Origens JavaScript autorizadas" no Google Cloud Console.
# Vazio -> o botão do Google simplesmente não aparece.
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Stripe em modo de TESTE
# -----------------------------------------------------------------------------
# Dashboard Stripe com o "Modo de teste" LIGADO -> Programadores -> Chaves de API
STRIPE_SECRET_KEY=sk_test_substituir
STRIPE_PUBLISHABLE_KEY=pk_test_substituir

# Em local não há webhook público. Com COMPOSE_PROFILES=dev (abaixo) sobe o
# container stripe-cli, que faz `stripe listen` e reencaminha os eventos para a
# API. O whsec_ que ele imprime no arranque vai para aqui:
#   docker compose logs stripe
STRIPE_WEBHOOK_SECRET=whsec_substituir

# Liga o container stripe-cli. NUNCA definir isto em produção.
COMPOSE_PROFILES=dev

# -----------------------------------------------------------------------------
# Emails via SMTP (opcional em teste)
# -----------------------------------------------------------------------------
# Vazio -> os emails são ignorados em silêncio (a API regista no log e segue).
# Atenção: sem SMTP não recebes o email de confirmação de conta; para testar
# registos, confirma a conta direto na BD ou preenche isto.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Biscuit&Arte

# -----------------------------------------------------------------------------
# Login social via Auth0 — opcional (só o Facebook acrescenta algo)
# -----------------------------------------------------------------------------
# Em Auth0, adiciona http://localhost:8090/auth/callback aos Allowed Callback
# URLs e http://localhost:8090 aos Allowed Web Origins.
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
