# Produção com frontend na Cloudflare Pages e API/BD no teu servidor.
#
# URLs públicas:
# FRONTEND_PUBLIC_URL=https://www.teudominio.pt
# API_PUBLIC_URL=https://api.teudominio.pt

FRONTEND_PUBLIC_URL=https://www.teudominio.pt
API_PUBLIC_URL=https://api.teudominio.pt

# Database local no servidor
MSSQL_DATABASE=Bijus
MSSQL_SA_PASSWORD=ChangeThis_StrongPassword_123!

# Generate with:
# openssl rand -hex 64
JWT_SECRET=ChangeThisToAReallyLongRandomSecretWithAtLeast64Characters

# Cloudflare Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=cole_aqui_o_token_do_cloudflare_tunnel

# Optional social login through Auth0
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_AUTH0_REDIRECT_URI=https://www.teudominio.pt/auth/callback
NEXT_PUBLIC_AUTH0_GOOGLE_CONNECTION=google-oauth2
NEXT_PUBLIC_AUTH0_FACEBOOK_CONNECTION=facebook
