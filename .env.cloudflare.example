# =============================================================================
# LEGADO — NÃO USAR PARA A PRODUÇÃO ATUAL
#
# Este ficheiro pertence a uma arquitetura antiga (frontend na Cloudflare Pages
# + API/BD no servidor, via docker-compose.cloudflare.yml). Ficou desatualizado:
# não tem SUPER_ADMIN_USERS/ADMIN_USERS, GOOGLE_CLIENT_ID, STRIPE_PUBLISHABLE_KEY
# nem SMTP_*, por isso o backoffice, o Google Sign-In, o Embedded Checkout e os
# emails de confirmação NÃO funcionam com esta stack.
#
# A produção atual é frontend + API + Caddy no mesmo servidor, atrás de um
# Cloudflare Tunnel:  usa .env.example e segue o DEPLOY.md.
# =============================================================================

# Produção com frontend na Cloudflare Pages e API/BD no teu servidor.
#
# URLs públicas:
# FRONTEND_PUBLIC_URL=https://www.teudominio.pt
# API_PUBLIC_URL=https://api.teudominio.pt

FRONTEND_PUBLIC_URL=https://www.teudominio.pt
API_PUBLIC_URL=https://api.teudominio.pt

# Database local no servidor
MSSQL_DATABASE=Bijus
MSSQL_SA_PASSWORD=ChangeThis_StrongPassword_123!

# Generate with:
# openssl rand -hex 64
JWT_SECRET=ChangeThisToAReallyLongRandomSecretWithAtLeast64Characters

# Cloudflare Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=cole_aqui_o_token_do_cloudflare_tunnel

# Optional social login through Auth0
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_AUTH0_REDIRECT_URI=https://www.teudominio.pt/auth/callback
NEXT_PUBLIC_AUTH0_GOOGLE_CONNECTION=google-oauth2
NEXT_PUBLIC_AUTH0_FACEBOOK_CONNECTION=facebook

# Stripe Checkout (MB WAY)
STRIPE_SECRET_KEY=sk_live_substituir
STRIPE_WEBHOOK_SECRET=whsec_substituir
