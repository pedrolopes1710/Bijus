# =============================================================================
# Biscuit&Arte — variáveis de ambiente (PRODUÇÃO)
#
#   cp .env.example .env     e preenche tudo o que está marcado com <...>
#
# Arranque (ver DEPLOY.md):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# IMPORTANTE: PUBLIC_SITE_URL, GOOGLE_CLIENT_ID, STRIPE_PUBLISHABLE_KEY e as
# NEXT_PUBLIC_* são build args do frontend (ver frontend/Dockerfile). Ao mudares
# qualquer uma delas tens de reconstruir com --build; um restart NÃO aplica.
# =============================================================================

# -----------------------------------------------------------------------------
# Endereço público
# -----------------------------------------------------------------------------
# DOMAIN = endereço em que o Caddy escuta DENTRO da rede Docker.
# Com Cloudflare Tunnel o HTTPS termina na Cloudflare e o túnel liga a caddy:80
# em HTTP simples, por isso deixa ":80".
# Se puseres aqui o domínio (biscuitarte.shop), o Caddy ativa HTTPS próprio e
# redireciona :80 -> :443 — o que, atrás do túnel, dá um ciclo de redirects.
DOMAIN=:80

# URL público real, o que o cliente vê no browser. Usado em:
#   ALLOWED_ORIGINS (CORS), links dos emails de confirmação de conta,
#   ReturnUrl da Stripe e NEXT_PUBLIC_API_URL do frontend.
PUBLIC_SITE_URL=https://biscuitarte.shop

# Origens aceites pelo CORS da API, separadas por virgula.
# TEM de incluir todos os enderecos por onde o site e servido. Se o www ficar
# de fora, quem entrar por la ve a loja a falhar a carregar os produtos --
# o browser bloqueia o pedido cross-origin, mesmo com o tunel a funcionar.
ALLOWED_ORIGINS=https://biscuitarte.shop,https://www.biscuitarte.shop

# Email do ACME/Let's Encrypt (o Caddyfile lê-o; com o túnel não emite cert).
ACME_EMAIL=<o-teu-email>

# -----------------------------------------------------------------------------
# Base de dados (SQL Server no container "db")
# -----------------------------------------------------------------------------
MSSQL_DATABASE=Bijus

# Password forte e única. ATENÇÃO: só é aplicada quando o volume
# bijus_sqlserver_data é criado de raiz. Se a BD já existe e mudares aqui,
# a connection string deixa de bater certo e a API não arranca.
MSSQL_SA_PASSWORD=<password-forte>

# -----------------------------------------------------------------------------
# Autenticação
# -----------------------------------------------------------------------------
# Gera um novo para produção:  openssl rand -hex 64
# Trocá-lo invalida todas as sessões ativas (todos têm de voltar a entrar).
JWT_SECRET=<openssl rand -hex 64>

# Backoffice — usernames separados por vírgula (case-insensitive):
#   SUPER_ADMIN_USERS -> acesso total
#   ADMIN_USERS       -> logística (encomendas + stock)
SUPER_ADMIN_USERS=<o-teu-username>
ADMIN_USERS=

# -----------------------------------------------------------------------------
# Google Sign-In  (botão nativo no login e no registo)
# -----------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (tipo "Web application"). Só o Client ID é preciso; o secret não é usado.
# Em produção, nesse cliente:
#   - Origens JavaScript autorizadas: https://biscuitarte.shop e https://www.biscuitarte.shop
#   - OAuth consent screen: publicar (passar de "Testing" para "In production")
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Stripe — Embedded Checkout (cartão, MB WAY, Multibanco, Klarna, Bancontact, EPS)
# -----------------------------------------------------------------------------
# Dashboard Stripe COM O MODO DE TESTE DESLIGADO:
#   Programadores -> Chaves de API
# A conta tem de estar ativada (dados do negócio + IBAN) para haver chaves live.
STRIPE_SECRET_KEY=sk_live_<...>
# Publicável: vai para o browser, não é secreta.
STRIPE_PUBLISHABLE_KEY=pk_live_<...>

# Programadores -> Webhooks -> Add endpoint (cria um NOVO em live; o de teste não serve)
#   URL: https://biscuitarte.shop/api/pagamentos/stripe/webhook
#   Eventos: checkout.session.completed
#            checkout.session.async_payment_succeeded
#            checkout.session.async_payment_failed
#            checkout.session.expired
# O "Signing secret" (whsec_...) desse endpoint vem para aqui.
STRIPE_WEBHOOK_SECRET=whsec_<...>

# Confirma também em Definições -> Métodos de pagamento que Cartão, MB WAY e
# Multibanco estão ativos EM LIVE. A lista de métodos é fixa no código
# (StripePagamentoService.cs); se algum estiver desativado o checkout falha.

# -----------------------------------------------------------------------------
# Emails automáticos (confirmação de conta + newsletter) via SMTP
# -----------------------------------------------------------------------------
# Password no painel do provedor de email (ex.: Hostinger -> Emails -> a caixa).
# Se SMTP_HOST ou SMTP_USER ficarem vazios o envio é ignorado em silêncio —
# e ninguém consegue confirmar a conta, por isso em produção isto é obrigatório.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465                      # 465 -> SSL direto; qualquer outro valor -> StartTLS
SMTP_USER=info@biscuitarte.shop
SMTP_PASSWORD=<password-da-caixa>
SMTP_FROM=info@biscuitarte.shop
SMTP_FROM_NAME=Biscuit&Arte

# -----------------------------------------------------------------------------
# Cloudflare Tunnel  (obrigatório para docker-compose.prod.yml)
# -----------------------------------------------------------------------------
# Zero Trust (one.dash.cloudflare.com) -> Networks -> Tunnels -> Create a tunnel
# -> tipo "Cloudflared" -> copia a string longa a seguir a `--token`.
# Depois, em Public Hostnames:
#   biscuitarte.shop      -> HTTP -> caddy:80
#   www.biscuitarte.shop  -> HTTP -> caddy:80
# O CNAME é criado automaticamente; não mexas nos registos MX/SPF/DKIM do email.
CLOUDFLARE_TUNNEL_TOKEN=<token-do-tunnel>

# -----------------------------------------------------------------------------
# Login social via Auth0 — OPCIONAL, só vale a pena para o Facebook
# -----------------------------------------------------------------------------
# O Google já tem botão nativo (GOOGLE_CLIENT_ID acima). Se preencheres isto,
# aparecem MAIS dois botões (Google via Auth0 + Facebook) por baixo do nativo.
# Deixa vazio para ficares só com o botão nativo do Google.
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
# Nota: o redirect URI e os nomes das connections NÃO se configuram aqui — o
# compose deriva o redirect de PUBLIC_SITE_URL (/auth/callback) e as connections
# usam os defaults "google-oauth2" e "facebook".

# -----------------------------------------------------------------------------
# NÃO definir em produção
# -----------------------------------------------------------------------------
# COMPOSE_PROFILES=dev  -> sobe o container stripe-cli, que reencaminharia
#                          webhooks usando a tua chave LIVE. Só para local.
