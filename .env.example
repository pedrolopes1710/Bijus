# Public address. After buying/configuring the domain, use:
# DOMAIN=example.com
# PUBLIC_SITE_URL=https://example.com
DOMAIN=localhost
PUBLIC_SITE_URL=http://localhost
ACME_EMAIL=admin@example.com

# Database
MSSQL_DATABASE=Bijus
MSSQL_SA_PASSWORD=PasswordSuperSegura123!

# Generate with:
# openssl rand -hex 64
JWT_SECRET=ChangeThisToAReallyLongRandomSecretWithAtLeast64Characters

# Optional social login through Auth0
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_AUTH0_REDIRECT_URI=http://localhost/auth/callback
NEXT_PUBLIC_AUTH0_GOOGLE_CONNECTION=google-oauth2
NEXT_PUBLIC_AUTH0_FACEBOOK_CONNECTION=facebook
