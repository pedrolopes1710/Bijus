# Public address. After buying/configuring the domain, use:
# DOMAIN=example.com
# PUBLIC_SITE_URL=https://example.com
DOMAIN=localhost
PUBLIC_SITE_URL=http://localhost
ACME_EMAIL=admin@example.com

# Database
MSSQL_DATABASE=Bijus
MSSQL_SA_PASSWORD=PasswordSuperSegura123!

# Generate with:
# openssl rand -hex 64
JWT_SECRET=ChangeThisToAReallyLongRandomSecretWithAtLeast64Characters

# Backoffice (usernames separados por vírgula):
#   SUPER_ADMIN_USERS -> gere tudo;  ADMIN_USERS -> logística (encomendas + stock)
SUPER_ADMIN_USERS=
ADMIN_USERS=

# Optional social login through Auth0
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_AUTH0_REDIRECT_URI=http://localhost/auth/callback
NEXT_PUBLIC_AUTH0_GOOGLE_CONNECTION=google-oauth2
NEXT_PUBLIC_AUTH0_FACEBOOK_CONNECTION=facebook

# Stripe (Embedded Checkout — MB WAY, Multibanco, cartão, etc.)
STRIPE_SECRET_KEY=sk_test_substituir
STRIPE_WEBHOOK_SECRET=whsec_substituir
# Chave publicável (frontend, Embedded Checkout). Não é secreta.
STRIPE_PUBLISHABLE_KEY=pk_test_substituir

# Google Sign-In (opcional): Client ID OAuth 2.0 (Web) do Google Cloud
GOOGLE_CLIENT_ID=

# Emails automáticos via SMTP (ex.: Hostinger: smtp.hostinger.com, porta 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Biscuit&Arte
