# =============================================================================
# Frontend em dev local SEM Docker (npm run dev) — copia para .env.local
#
#   cp .env.example .env.local
#
# Em Docker este ficheiro NÃO é usado: o docker-compose.yml passa estes valores
# como build args a partir do .env da raiz. Aqui é só para `npm run dev`.
# =============================================================================

# API a correr com `dotnet run --project dddnetcore`
NEXT_PUBLIC_API_URL=http://localhost:5225/api

# Stripe Embedded Checkout — chave PUBLICÁVEL (pk_test_... em dev).
# Sem isto o formulário de pagamento não renderiza no checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Sign-In: mesmo Client ID OAuth 2.0 (Web) do backend.
# Adiciona http://localhost:3000 às "Origens JavaScript autorizadas".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Dados de exemplo sem backend a correr: NEXT_PUBLIC_USE_MOCKS=1
NEXT_PUBLIC_USE_MOCKS=

# -----------------------------------------------------------------------------
# Login social via Auth0 — opcional (o Google já tem botão nativo acima)
# -----------------------------------------------------------------------------
# Allowed Callback URLs: http://localhost:3000/auth/callback
# Allowed Web Origins:   http://localhost:3000
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_AUTH0_GOOGLE_CONNECTION=google-oauth2
NEXT_PUBLIC_AUTH0_FACEBOOK_CONNECTION=facebook
